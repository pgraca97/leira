/**
 * Cloudflare Worker that serves the built app and the /api routes.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leira",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    // Lets the Worker read the built files: it serves the app shell, app.html.
    "binding": "ASSETS",
    // The landing page is the static index.html, so an unknown path gets the
    // nearest 404.html with a 404, not the app.
    "not_found_handling": "404-page",
    // The API and the app's pages: the Worker answers these, the static files
    // everything else. A page the router knows must be here (see router.test.ts).
    // `/app` is the shell's own address, kept out of search results like the rest.
    "run_worker_first": [
      "/api/*",
      "/app",
      // Google Search Console's verification file, see worker/app.ts.
      "/google2109b0318d502cf4.html",
      "/gardens",
      "/gardens/*",
      "/shared/*",
      "/stats",
      "/privacy"
    ]
  },
  // Caches weather readings. The id is filled in when the namespace is first created on deploy.
  "kv_namespaces": [{ "binding": "CACHE" }],
  // Both count per visitor address. A namespace id is any number not yet used in the account.
  "ratelimits": [
    // Every call to a weather or place route, cached or not.
    { "name": "API_LIMIT", "namespace_id": "5301", "simple": { "limit": 60, "period": 60 } },
    // Calls the cache could not answer: each one spends the provider's quota and a KV write.
    { "name": "LOOKUP_LIMIT", "namespace_id": "5302", "simple": { "limit": 10, "period": 60 } }
  ],
  // Set per environment: `.dev.vars` locally, `wrangler secret put` when deployed.
  // The Supabase values and the Turnstile site key are public, but each environment
  // still needs its own. Only the keys listed here are read from `.dev.vars`.
  // The SMTP ones are listed for that reason: the Worker sends no email while any of
  // them is empty, but locally they point it at the stack's Mailpit.
  "secrets": {
    "required": [
      "OPENWEATHER_API_KEY",
      "SMTP_HOST",
      "SMTP_PASSWORD",
      "SMTP_PORT",
      "SMTP_USER",
      "SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_URL",
      "TURNSTILE_SITE_KEY"
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
